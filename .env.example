# URL base del monolito Spring Boot (solo servidor; nunca expuesto al navegador).
# Requerida cuando NEXT_PUBLIC_API_MOCKS no es "true".
PLATFORM_API_URL=http://localhost:8080

# "true" = el BFF responde con los mocks MSW en lugar de llamar al backend.
# Se incrusta en build: cambiarla requiere reiniciar `next dev` o reconstruir.
NEXT_PUBLIC_API_MOCKS=true

# Paso de verificación 2FA (TOTP) después del login.
NEXT_PUBLIC_FEATURE_MFA=false

# Solo para e2e/CI: permite mocks con NODE_ENV=production (`next start`).
# ALLOW_MOCKS_IN_PRODUCTION=true
